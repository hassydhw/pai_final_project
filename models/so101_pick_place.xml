<!--
  SO-101 (簡易モデル) + Pick & Place 環境

  ・アーム各関節は position アクチュエータで駆動（qpos 直書きだと接触が破綻するため）
  ・2 本指の平行グリッパー（slide 関節 × 2）
  ・赤ブロック（把持対象）と緑ターゲットエリア（配置先）

  衝突フィルタ（contype / conaffinity）:
    world クラス（床・ブロック・ターゲット）: contype=1 conaffinity=3
    arm   クラス（アームリンク・指）        : contype=2 conaffinity=1
    → arm 同士は衝突しない（自己干渉で暴れない）、arm と world は衝突する
-->
<mujoco model="so101_pick_place">
  <compiler angle="radian" autolimits="true"/>

  <!-- 把持の安定化: elliptic cone + 高い impratio で指と物体の滑りを抑える -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" impratio="10"/>

  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.8 0.8 0.8"/>
    <global offwidth="1280" offheight="720"/>
    <!-- 影を高解像度に（アームと物体の位置関係を影で把握しやすくする） -->
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <default class="world">
      <geom contype="1" conaffinity="3"/>
    </default>
    <default class="arm">
      <geom contype="2" conaffinity="1" density="800"/>
      <joint damping="1.0" armature="0.01"/>
      <position kp="60" kv="2" forcerange="-10 10"/>
    </default>
    <default class="finger">
      <!-- 指先は高摩擦・ねじり摩擦あり（condim=4）で物体の回転滑りも抑える -->
      <geom contype="2" conaffinity="1" condim="4" friction="1.5 0.02 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001" density="800"/>
      <joint type="slide" damping="0.5" armature="0.001"/>
      <position kp="150" kv="5" forcerange="-5 5"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>
    <light pos="0.5 0.5 1.0" dir="-0.5 -0.5 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" class="world" type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"
          friction="1.0 0.005 0.0001"/>

    <!-- ターゲット位置表示用（赤小球）: mocap で毎フレーム位置を更新、衝突なし -->
    <body name="target_site" mocap="true" pos="0.15 0.0 0.15">
      <geom type="sphere" size="0.012" rgba="1 0 0 0.4" contype="0" conaffinity="0"/>
    </body>

    <!-- 緑の目標エリア（薄いボックス。ブロックが上に乗れるよう衝突あり）
         ※ MuJoCo は半透明 geom に影を落とさないので alpha=1 にしておく -->
    <body name="place_area" pos="0.16 -0.12 0">
      <geom name="place_area_geom" class="world" type="box" size="0.04 0.04 0.002"
            pos="0 0 0.002" rgba="0.1 0.8 0.2 1" friction="1.0 0.005 0.0001"/>
    </body>

    <!-- 赤い小ブロック（一辺 3cm, 30g） -->
    <body name="red_block" pos="0.17 0.10 0.015">
      <freejoint name="red_block_joint"/>
      <geom name="red_block_geom" class="world" type="box" size="0.015 0.015 0.015"
            mass="0.03" rgba="0.9 0.1 0.1 1" condim="4" friction="1.5 0.02 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>

    <!-- SO-101 アーム（重力補償 gravcomp=1 で自重による垂れ下がりを防ぐ） -->
    <body name="base_link" pos="0 0 0">
      <geom name="base_geom" class="arm" type="cylinder" size="0.05 0.02" rgba="0.2 0.2 0.2 1" pos="0 0 0.01"/>

      <!-- Joint 1: Base Rotation -->
      <body name="link1" pos="0 0 0.02" gravcomp="1">
        <joint name="joint1" class="arm" axis="0 0 1" range="-3.14 3.14"/>
        <geom name="link1_geom" class="arm" type="capsule" fromto="0 0 0 0 0 0.06" size="0.02" rgba="0.8 0.2 0.2 1"/>

        <!-- Joint 2: Shoulder Pitch -->
        <body name="link2" pos="0 0 0.06" gravcomp="1">
          <joint name="joint2" class="arm" axis="0 1 0" range="-1.57 1.57"/>
          <geom name="link2_geom" class="arm" type="capsule" fromto="0 0 0 0 0 0.12" size="0.018" rgba="0.2 0.8 0.2 1"/>

          <!-- Joint 3: Elbow Pitch -->
          <body name="link3" pos="0 0 0.12" gravcomp="1">
            <joint name="joint3" class="arm" axis="0 1 0" range="-2.2 2.2"/>
            <geom name="link3_geom" class="arm" type="capsule" fromto="0 0 0 0 0 0.10" size="0.015" rgba="0.2 0.2 0.8 1"/>

            <!-- Joint 4: Wrist Pitch -->
            <body name="link4" pos="0 0 0.10" gravcomp="1">
              <joint name="joint4" class="arm" axis="0 1 0" range="-2.0 2.0"/>
              <geom name="link4_geom" class="arm" type="capsule" fromto="0 0 0 0 0 0.05" size="0.012" rgba="0.8 0.8 0.2 1"/>

              <!-- Gripper: 掌（palm）+ 平行 2 本指（y 方向に開閉） -->
              <body name="gripper_link" pos="0 0 0.05" gravcomp="1">
                <geom name="gripper_geom" class="arm" type="box" size="0.015 0.045 0.006" pos="0 0 0.006" rgba="0.1 0.1 0.1 1"/>
                <!-- 把持中心（joint4 から 0.095m 先）。IK の工具長 L_TOOL と一致させる -->
                <site name="ee_site" pos="0 0 0.045" size="0.004" rgba="1 1 0 1"/>

                <body name="finger_left" pos="0 0 0.012" gravcomp="1">
                  <joint name="finger_left_joint" class="finger" axis="0 1 0" range="0 0.03"/>
                  <geom name="finger_left_geom" class="finger" type="box" size="0.012 0.004 0.025"
                        pos="0 0.004 0.025" rgba="0.3 0.3 0.3 1"/>
                </body>
                <body name="finger_right" pos="0 0 0.012" gravcomp="1">
                  <joint name="finger_right_joint" class="finger" axis="0 -1 0" range="0 0.03"/>
                  <geom name="finger_right_geom" class="finger" type="box" size="0.012 0.004 0.025"
                        pos="0 -0.004 0.025" rgba="0.3 0.3 0.3 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_joint1" class="arm" joint="joint1" ctrlrange="-3.14 3.14"/>
    <position name="act_joint2" class="arm" joint="joint2" ctrlrange="-1.57 1.57"/>
    <position name="act_joint3" class="arm" joint="joint3" ctrlrange="-2.2 2.2"/>
    <position name="act_joint4" class="arm" joint="joint4" ctrlrange="-2.0 2.0"/>
    <position name="act_finger_left" class="finger" joint="finger_left_joint" ctrlrange="0 0.03"/>
    <position name="act_finger_right" class="finger" joint="finger_right_joint" ctrlrange="0 0.03"/>
  </actuator>

  <!-- 初期姿勢: 手首を下に向けて前方の空中に構える
       qpos は body の木構造順 → [red_block freejoint(7), joint1-4, finger×2] -->
  <keyframe>
    <key name="home"
         qpos="0.17 0.10 0.015 1 0 0 0  0 0.3 1.4 1.44 0.03 0.03"
         ctrl="0 0.3 1.4 1.44 0.03 0.03"/>
  </keyframe>
</mujoco>
